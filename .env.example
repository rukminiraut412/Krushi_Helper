# ==============================================================================
# KrushiRakshak Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the services:
# cp .env.example .env

# Database Configuration
DATABASE_URL=postgresql://krushirakshak:krushirakshak_secret@localhost:5432/krushirakshak_db

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Third-party Weather & Climate Telemetry APIs
WEATHER_API_KEY=your_openweather_or_imd_api_key_here

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Service Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
